{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SiteSettings": {
    "CV": {
      "MaxFileSizeInBytes": 10485760,
      "AllowedContentTypes": [
        "application/pdf"
      ]
    },
    "Images": {
      "MaxFileSizeInBytes": 5242880,
      "AllowedContentTypes": [
        "image/jpeg",
        "image/png",
        "image/webp"
      ],
      "AllowedExtensions": [
        ".jpg",
        ".jpeg",
        ".png",
        ".webp"
      ]
    }
  }
}
